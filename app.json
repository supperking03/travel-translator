{
  "expo": {
    "name": "Nomad Translator",
    "slug": "travel-translator",
    "version": "1.5.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/f37ecf15-6d9a-4a62-a746-5115315b6832"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theluxenomad.freeofflinetranslator",
      "buildNumber": "11",
      "appStoreUrl": "https://apps.apple.com/app/id6766855589?action=write-review",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Used for voice input translation",
        "NSCameraUsageDescription": "Used to take a photo and extract text for offline translation",
        "NSPhotoLibraryUsageDescription": "Used to choose a photo and extract text for offline translation",
        "NSPhotoLibraryAddUsageDescription": "Used when saving images picked for offline translation"
      }
    },
    "android": {
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.theluxenomad.freeofflinetranslator",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-padded.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.theluxenomad.freeofflinetranslator",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-image-picker",
      "./plugins/withWhisperModel",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ],
    "scheme": "travel-translator",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f37ecf15-6d9a-4a62-a746-5115315b6832"
      }
    },
    "owner": "supperking03"
  }
}
